{
  "$schema": "https://opencode.ai/config.json",
  // OpenAI-compatible provider served by `fm serve` on 127.0.0.1.
  // Note: install.sh also installs plugins/applefm-compat, required to make
  // tool schemas compatible with AFM (`pattern` keyword and 8K limit).
  // Automatic checkpoints are disabled: with 8K of context they generate
  // summaries that the model rereads as instructions and loops on.
  "compaction": {
    "auto": false
  },
  "providers": {
    "applefm": {
      "name": "Apple Foundation Model (on-device)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:1976/v1",
        "apiKey": "unused"
      },
      "models": {
        "system": {
          "name": "AFM 3 Core Advanced (on-device)",
          "modelID": "system",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    }
  },
  // Optional: dedicated agent. Do not set `system`, so OpenCode keeps its
  // base prompt with instructions for using tools.
  "agents": {
    "applefm": {
      "description": "Apple on-device Foundation Model: fast, private, 8K context",
      "mode": "primary",
      "model": "applefm/system"
    }
  }
}
