{
  "$schema": "https://opencode.ai/config.json",
  // Provider OpenAI-compatible servito da `fm serve` su 127.0.0.1.
  // Nota: install.sh installa anche plugins/applefm-compat, necessario per
  // rendere gli schemi dei tool compatibili con AFM (keyword `pattern` e limite 8K).
  // I checkpoint automatici sono disattivati: con 8K di contesto generano
  // riepiloghi che il modello rilegge come istruzioni, entrando in loop.
  "compaction": {
    "auto": false
  },
  "providers": {
    "applefm": {
      "name": "Apple Foundation Model (on-device)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:1976/v1",
        "apiKey": "unused"
      },
      "models": {
        "system": {
          "name": "AFM 3 Core Advanced (on-device)",
          "modelID": "system",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    }
  },
  // Opzionale: agente dedicato. Non impostare `system`, così OpenCode
  // mantiene il suo prompt base con le istruzioni per l'uso degli strumenti.
  "agents": {
    "applefm": {
      "description": "Apple on-device Foundation Model: veloce, privato, contesto 8K",
      "mode": "primary",
      "model": "applefm/system"
    }
  }
}
